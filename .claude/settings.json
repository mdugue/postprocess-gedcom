{
  "permissions": {
    "allow": [
      "ClaudeInChromeDomain(localhost:3457)",
      "ClaudeInChromeDomain(localhost:3456)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "Bash(timeout 90 bun test)",
      "Bash(timeout 90 bun run typecheck)",
      "Bash(echo \"exit: $?\")"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bunx ultracite fix --hook"
          }
        ]
      }
    ]
  }
}
